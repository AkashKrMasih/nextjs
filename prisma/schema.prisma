// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  friendlyId  String   @unique @map("friendly_id")
  description String   @default("")
  price          Decimal @db.Decimal(10, 2) // default price; a variant may override this
  priceOnRequest Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  reviews     Review[]
  avgRating   Float    @default(0)
  reviewCount Int      @default(0)

  images   ProductImage[]
  variants ProductVariant[]

  attributes ProductAttribute[]

  wishlistItems WishlistItem[]
  priceRequests PriceRequest[]
  discounts     Discount[]

  @@index([categoryId])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  // self-relation for optional subcategories (nullable parentId = top-level category)
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// A purchasable variation of a Product (e.g. "Red / Large").
// Every product should have at least one variant, even if it doesn't have
// real options — see the isDefault flag below.
model ProductVariant {
  id        String  @id @default(cuid())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku   String   @unique
  name  String? // e.g. "Red / Large"; null is fine for a default/simple-product variant
  price Decimal? @db.Decimal(10, 2) // overrides Product.price when set

  // Flexible variant options, e.g. { "color": "Red", "size": "L" }.
  // Enforce shape/required option keys in the app layer.
  attributes Json?

  // True for the single auto-created variant on a product that has no real
  // options — lets cart/order code always deal with a variantId.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// Kept separate from ProductVariant on purpose so it can grow independently
// (multi-warehouse, reservations, low-stock alerts, etc.) without touching
// the product/variant models again.
model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(0)
  reserved Int @default(0) // held for pending carts/orders; available = quantity - reserved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: 1:1 with variant for now. When you need multi-location stock later,
  // drop the @unique on variantId, add a Location/Warehouse model, and key
  // this on (variantId, locationId) instead.
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isPrimary Boolean @default(false) // enforce "only one primary per product" in the app layer

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId])
}

// A named attribute belonging to a product (e.g. "Color", "Material").
// Each attribute holds a single value (e.g. Material -> Cotton). To give
// a product multiple values for the same concept, add multiple
// ProductAttribute rows with the same title.
model ProductAttribute {
  id    String @id @default(cuid())
  title String

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([title])
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  password       String
  password_salt  String
  role           Role           @default(CUSTOMER)
  emailVerified  Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emailVerificationTokens EmailVerificationToken[]
  reviews        Review[]
  orders         Order[]
  orderAddresses OrderAddress[]
  addresses      UserAddress[]
  wishlist       Wishlist?
  priceRequests  PriceRequest[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PriceRequest {
  id           String  @id @default(cuid())
  email        String
  productTitle String
  message      String  @db.Text

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

// Saved delivery addresses for logged-in users, so they can pick from a
// list at checkout instead of retyping. Guest checkouts have no login
// session to attach these to, so guests fill OrderAddress fresh each time.
model UserAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String? // e.g. "Home", "Work" — optional, user-facing only
  name    String // recipient name
  phone   String?

  address1   String
  address2   String?
  city       String
  state      String?
  postalCode String
  country    String

  // Exactly one default per user — enforce in app layer (unset the previous
  // default in the same transaction when a new one is set).
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderAddresses OrderAddress[] // orders that were snapshotted from this saved address

  @@index([userId])
}

model Review {
  id String @id @default(cuid())

  rating  Int // 1-5, enforce in app layer + optional DB check
  title   String?
  comment String? @db.Text

  // Verified purchase badge
  isVerifiedPurchase Boolean @default(false)

  // Moderation
  status ReviewStatus @default(PENDING)

  // Helpful votes
  helpfulCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  images ReviewImage[]

  @@unique([productId, userId]) // one review per user per product
  @@index([productId])
  @@index([userId])
  @@index([status])
}

model ReviewImage {
  id       String @id @default(cuid())
  url      String
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Cart {
  id        String     @id @default(cuid())
  userId    Int? // set once a guest logs in / for logged-in users
  sessionId String? // set for guest carts (httpOnly cookie value)
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name      String // snapshot at add-time; re-validate against variant/product at checkout
  price     Decimal        @db.Decimal(10, 2) // snapshot at add-time
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

enum CartStatus {
  ACTIVE
  CONVERTED // turned into an Order at checkout
  ABANDONED // optional: set by a cleanup job after N days of inactivity
}

model Wishlist {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId]) // no duplicate saves of the same product
  @@index([productId])
}

model AdminSettings {
  id        Int      @id @default(1) // fixed to 1 — singleton row
  stripe    Json? // { publishableKey, secretKey, webhookSecret }
  currency  Json? // { symbol, code } e.g. { symbol: "₹", code: "INR" }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                    String       @id @default(cuid())
  userId                String? // null for guest checkout
  user                  User?        @relation(fields: [userId], references: [id])
  guestEmail            String? // set when userId is null
  status                OrderStatus  @default(PENDING)
  amountTotal           Int // cents, matches Stripe's PaymentIntent.amount
  currency              String       @default("usd")
  stripePaymentIntentId String       @unique
  items                 OrderItem[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // OrderAddress owns the FK (orderId @unique on that side), so this side
  // is just the reverse lookup — no fields/references here.
  address OrderAddress?
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  name         String // snapshot at purchase time
  unitPrice    Int // cents, snapshot at purchase time (after any discount)
  quantity     Int
  discountCode String? // code applied to this line, if any
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

// A checkout code. productId null means it applies to every product.
// expiresAt is the last moment the code can be used.
model Discount {
  id        String       @id @default(cuid())
  code      String       @unique
  kind      DiscountKind
  value     Decimal      @db.Decimal(10, 2)
  productId Int?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId])
}

model OrderAddress {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Optional: links the address back to the account for guest checkouts
  // (userId is null) or logged-in orders. Kept nullable to match Order.userId.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Optional: if a logged-in user picked one of their saved addresses at
  // checkout, this points back to it. Null for guest orders (no saved
  // address exists) and still null if the user typed a one-off address
  // instead of picking a saved one. This is a pointer only — the fields
  // below are always the source of truth for what the order actually
  // shipped to, even if the saved address is edited/deleted later.
  savedAddressId String?
  savedAddress   UserAddress? @relation(fields: [savedAddressId], references: [id], onDelete: SetNull)

  name       String
  phone      String?
  address1   String
  address2   String?
  city       String
  state      String?
  postalCode String
  country    String

  @@index([userId])
  @@index([savedAddressId])
}